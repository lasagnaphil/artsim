<robot name="two_link_art">
    <link name="base"/>
    <link name="link1">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="15"/>
            <inertia ixx="0.0473569" iyy="0.0751666" izz="0.0806626" iyz="0" izx="0" ixy="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 0.2 0.2"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 0.2 0.2"/>
            </geometry>
        </collision>
    </link>
    <joint name="joint1" type="floating">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="base"/>
        <child link="link1"/>
    </joint>
    <link name="link2">
        <inertial>
            <origin xyz="-0.0056 -0.2096 -0.0111" rpy="3.12439 -0.00240011 0.0138864"/>
            <mass value="7"/>
            <inertia ixx="0.106751" iyy="0.0208241" izz="0.104774" iyz="0" izx="0" ixy="0"/>
        </inertial>
        <visual>
            <origin xyz="-0.0056 -0.2096 -0.0111" rpy="3.12439 -0.00240011 0.0138864"/>
            <geometry>
                <box size="0.1271 0.4043 0.1398"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="-0.0056 -0.2096 -0.0111" rpy="3.12439 -0.00240011 0.0138864"/>
            <geometry>
                <box size="0.1271 0.4043 0.1398"/>
            </geometry>
        </collision>
    </link>
    <joint name="FemurR" type="spherical">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="link1"/>
    </joint>
</robot>